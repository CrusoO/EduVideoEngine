# Copy to .env and fill in. .env is ignored by git; this file is committed and must never hold a real key (pnpm secrets:check enforces it).
# Everything about the model is configured here. Switching key, model or provider needs no code change (ADR 0023).

# Which provider adapter to use. Only "gemini" exists today; a second one is a new adapter file and nothing else (see ADR 0023).
LLM_PROVIDER=gemini

# The key. Leave empty in replay mode (the default): no key is needed to run the tests or to replay recorded fixtures.
GEMINI_API_KEY=

# Models. Defaults chosen from Google's official model page on 2026-10-13: the newest STABLE Flash, the previous stable Flash, the newest stable Flash-Lite.
# All three are free-tier models. Free-tier models may be Flash or Flash-Lite only. Do not use -preview ids for recorded fixtures (ADR 0023).
# Adding a model: add an entry to packages/adapters/model-profiles.json. Nothing else.
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.6-flash
LLM_LIGHT_MODEL=gemini-3.5-flash-lite

# replay (default): answer only from recorded fixtures; a missing fixture fails. record: call the model and save the answer as a fixture. live: call the model, save nothing.
LLM_MODE=replay

# Limits for the model you chose. Google's public rate-limit page does not print the free-tier numbers (it points to your AI Studio dashboard), so read them
# there and put them here. Left empty, the profile's deliberately LOW numbers are used and a warning says so.
LLM_RPM=
LLM_DAILY_REQUEST_CAP=

# Thinking. Gemini 3 models take a LEVEL (minimal, low, medium, high); older models take a token BUDGET. Set the one your model supports; the profile says which.
# Thinking tokens are counted in the ledger and may count toward limits.
LLM_THINKING_LEVEL=low
LLM_THINKING_BUDGET=

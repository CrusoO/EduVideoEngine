{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": ["packages/schema/src/migrate.ts", "packages/patterns/src/arcs.ts", "packages/content/src/derive.ts", "packages/schema/src/validate.ts", "packages/content/src/validate.ts"],
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation-co2.json" },
  "thresholds": { "high": 95, "low": 90, "break": 0 },
  "coverageAnalysis": "perTest",
  "concurrency": 6,
  "timeoutMS": 60000
}

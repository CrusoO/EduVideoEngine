  "tracks": [
    {
      "sentenceId": "s1.1",
      "spokenText": "Here is a quadratic equation: x squared minus five x plus six equals zero.",
      "trackHash": "4c75d1616c445d69bb4d443fbc422e227b6500fb4ffcc8df20899cabd9be8695",
      "file": "s1.1.wav",
      "fileSha256": "d0ee2e9063aac93a2869e6758f0e396992e1d8c32281b3a0fe5a6e8d23711786",
      "sampleRate": 22050,
      "durationMs": 5494
    },
    {
      "sentenceId": "s1.2",
      "spokenText": "It has two roots. Before we solve it, guess what they add up to.",
      "trackHash": "143b4e645e573f3e307202115254d85318a2080b4f88877584c7cd4c9a22e3de",
      "file": "s1.2.wav",
      "fileSha256": "ffcad9671856cd0a0cfc5ea608a737481c6b8523406097df3dc755fa2edcf7d3",
      "sampleRate": 22050,
      "durationMs": 3953
    },
    {
      "sentenceId": "s2.1",
      "spokenText": "Let us draw this equation. The curve is called a parabola.",
      "trackHash": "41238952e2a62c5b21cf2f9db30cb9df4de8f48b96794b3d5f9ea6d807b78d8c",
      "file": "s2.1.wav",
      "fileSha256": "122a01fb5644599de20e319f265ab4e9e35cfdc422c6af6fe229dfad92b846a5",
      "sampleRate": 22050,
      "durationMs": 3535
    },
    {
      "sentenceId": "s2.2",
      "spokenText": "The roots are the two places where the curve crosses the horizontal axis.",
      "trackHash": "a3b162394736959fb9e4123db5c1096578dd5b3b6681f0dc733169c92046f639",
      "file": "s2.2.wav",
      "fileSha256": "a0440b5465efe0dcda0cfd4e4358301540aa3b7acf949c33dc62606fcc738b32",
      "sampleRate": 22050,
      "durationMs": 4124
    },
    {
      "sentenceId": "s3.1",
      "spokenText": "One root is two.",
      "trackHash": "2bdd69423ee3cd2d97b4ade275d5cbef4fa3925744b28f63ccb7c14f8f1632cc",
      "file": "s3.1.wav",
      "fileSha256": "918e5c08ed32768aae22a2805afdb92b4502605da0834cd542d7ec9259168191",
      "sampleRate": 22050,
      "durationMs": 1442
    },
    {
      "sentenceId": "s3.2",
      "spokenText": "The other root is three.",
      "trackHash": "a3a7529d71387a3d4944a8f3985028efe3f6e8223d73fe728954d7808f10923b",
      "file": "s3.2.wav",
      "fileSha256": "057e07f225ab7c754ab544e96188571ffc79b5f4ee711745491dc98713cc9b49",
      "sampleRate": 22050,
      "durationMs": 1477
    },
    {
      "sentenceId": "s3.3",
      "spokenText": "Now we have found both roots.",
      "trackHash": "ff92d1773308ea55f184a4c83463c4ca9bf309f2e35aa0a068267725c8e754cd",
      "file": "s3.3.wav",
      "fileSha256": "18a6e8ba86cad537861536df84705b52d562194b6bcf7e9bb44c472e0744a170",
      "sampleRate": 22050,
      "durationMs": 1918
    },
    {
      "sentenceId": "s4.1",
      "spokenText": "Start at zero. The first root is two, so hop to two.",
      "trackHash": "9d58261ab5515e23e07a6f9d417e3af356507d19ee3a9b5c9bb6b25ac4a5b142",
      "file": "s4.1.wav",
      "fileSha256": "0a015059dc9cd86b4f1bcc3cca4c19ef7c6fb8a0743e1222a12f0da85dccc997",
      "sampleRate": 22050,
      "durationMs": 3837
    },
    {
      "sentenceId": "s4.2",
      "spokenText": "The second root is three, so hop three more and land on five.",
      "trackHash": "6bc9780eee248a60c2579384fb305d96ae5d3eaacad1093fbd6f07035baf9135",
      "file": "s4.2.wav",
      "fileSha256": "8d9c7ad245cca79512bc19b0e8ad6472b4e40ae9d92214862c0498505d934db2",
      "sampleRate": 22050,
      "durationMs": 3776
    },
    {
      "sentenceId": "s4.3",
      "spokenText": "The two roots add up to two plus three equals five.",
      "trackHash": "f6d7d4d23a42e1b68d7ce07c4d30cbd9150630355b301e16ea9720984778ec8e",
      "file": "s4.3.wav",
      "fileSha256": "5de817a0eb26e2d0b21e08528b8bc2b5dd33520a46ad7b9d283718cc6c46a638",
      "sampleRate": 22050,
      "durationMs": 3613
    },
    {
      "sentenceId": "s4.4",
      "spokenText": "Look at the minus five x term. The sum is five, the same number with its sign flipped.",
      "trackHash": "ed95a453de8c4728b2fc675f8bfe292ed51d6448e0165e630177cdb50d46566d",
      "file": "s4.4.wav",
      "fileSha256": "375097613bc44a149f707c82a21b05d596230ebb755e0b589329c775a6044d12",
      "sampleRate": 22050,
      "durationMs": 5288
    }
  ]
}

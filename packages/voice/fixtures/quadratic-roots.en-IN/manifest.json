  "tracks": [
    {
      "sentenceId": "s1.1",
      "spokenText": "Here is a quadratic equation: x squared minus five x plus six equals zero.",
      "trackHash": "4c75d1616c445d69bb4d443fbc422e227b6500fb4ffcc8df20899cabd9be8695",
      "file": "s1.1.wav",
      "fileSha256": "4f3a50270e9a2f5459ab7d7db1d9ba6a50521e52a0424bf670e061324ad9da95",
      "sampleRate": 22050,
      "durationMs": 5529
    },
    {
      "sentenceId": "s1.2",
      "spokenText": "It has two roots. Before we solve it, guess what they add up to.",
      "trackHash": "143b4e645e573f3e307202115254d85318a2080b4f88877584c7cd4c9a22e3de",
      "file": "s1.2.wav",
      "fileSha256": "d1001653dfc7ee601de6c2e98433d2b4feb36b4ebeef7d364c63035f8733f4d5",
      "sampleRate": 22050,
      "durationMs": 4208
    },
    {
      "sentenceId": "s2.1",
      "spokenText": "For any equation of the form a x squared plus b x plus c equals zero, there is a shortcut.",
      "trackHash": "97cc77d9375081bd100ce6b9152e3ef6f8eefa78a1e83fcc675e2089463491e4",
      "file": "s2.1.wav",
      "fileSha256": "bac1ce94f1447c7b166efcc7b0a41587f69a7ce929018ae869cd8cf4bfe49ef6",
      "sampleRate": 22050,
      "durationMs": 6690
    },
    {
      "sentenceId": "s2.2",
      "spokenText": "The sum of the two roots is always S equals minus b over a.",
      "trackHash": "2ed035e0cf85e2bd60eb293a7ecf9facaf30aad9fd7c4c968c49b9c9f92f92d0",
      "file": "s2.2.wav",
      "fileSha256": "e4cb1ad120414d2fdee1f98e8db51751cc7f788f1cc6e146da83e6d5a168c843",
      "sampleRate": 22050,
      "durationMs": 3590
    },
    {
      "sentenceId": "s2.3",
      "spokenText": "You only need the first two coefficients. The last one does not matter.",
      "trackHash": "ed00467dcde043c3665d0ee7d26a2d33c4d12876360c883d7b8fbf9794d054c8",
      "file": "s2.3.wav",
      "fileSha256": "5d8d09eacb4962f91667938a63a0cc4e92eb5325954f713ed12864e71ae8c3e4",
      "sampleRate": 22050,
      "durationMs": 4092
    },
    {
      "sentenceId": "s3.1",
      "spokenText": "Let us check it. Factorise the equation to get open bracket x minus two close bracket open bracket x minus three close bracket equals zero.",
      "trackHash": "662b4bb5ba573ad79aea490108120ab0b480c5cf26a14b40b0f30f1a7e2aecc8",
      "file": "s3.1.wav",
      "fileSha256": "7ab795f225033188cf6aad8f771181cd2a59f1f44adee67102ef9d919bc385a0",
      "sampleRate": 22050,
      "durationMs": 9607
    },
    {
      "sentenceId": "s3.2",
      "spokenText": "So the roots are two and three, and two plus three equals five.",
      "trackHash": "07b4e9db4ef5c034bb1e5d5a1167eb65965a3244945b3c082d68abac4f39de1b",
      "file": "s3.2.wav",
      "fileSha256": "7019a5af28eb656e48931fef30b263e6b61407fc0a36c5a834c64e03d8e36fd8",
      "sampleRate": 22050,
      "durationMs": 4298
    },
    {
      "sentenceId": "s3.3",
      "spokenText": "The rule gives the same answer: minus the fraction minus five over one end fraction equals five.",
      "trackHash": "8a908bf64607287fc7a3ae10318b6491a307d3df6d3dca9c79475fd4c25bb37c",
      "file": "s3.3.wav",
      "fileSha256": "51d05f9f3ee1b8ae8320be6a09782be3a586aafb2d5cbdecb4e20431d4c34922",
      "sampleRate": 22050,
      "durationMs": 6911
    },
    {
      "sentenceId": "s4.1",
      "spokenText": "On the graph, the roots are where the curve crosses the horizontal axis.",
      "trackHash": "35f5e533d9b79e4a696854b2c5e4577500332e6c86304c14345650a151b072de",
      "file": "s4.1.wav",
      "fileSha256": "511102775631bf0cf3116bc3b7fb242a22aade2afcc28359555af0c0d420d704",
      "sampleRate": 22050,
      "durationMs": 4414
    },
    {
      "sentenceId": "s4.2",
      "spokenText": "The crossings are at two and three, exactly halfway between them sits the lowest point.",
      "trackHash": "d7dee006f69fe4b1e15eb1d78406111434b8679b11f76920e1c5b176dcee5d06",
      "file": "s4.2.wav",
      "fileSha256": "262f1d69eb03e983668237944c89ee57fb1752d55c1f95ab1b3e762bb774edb2",
      "sampleRate": 22050,
      "durationMs": 5007
    },
    {
      "sentenceId": "s5.1",
      "spokenText": "Now you try. For x squared minus seven x plus ten equals zero, what do the roots add up to?",
      "trackHash": "368745e8e7431e8e2a9a481069d7a243dea8422c50cce22f475054895df673bc",
      "file": "s5.1.wav",
      "fileSha256": "197e82fc24aa878a45863fe9e1c19359c65038dc20bb53f19dd1fb4220060fc0",
      "sampleRate": 22050,
      "durationMs": 6820
    },
    {
      "sentenceId": "s5.2",
      "spokenText": "Use the rule, then check your answer.",
      "trackHash": "17dbadd880f259051007ea42c076ad917b47ab0ec0ed50c5c858a847fa7cf464",
      "file": "s5.2.wav",
      "fileSha256": "b25ff31152f845c3e287380ec022c1b0bc074767294e97728fcee67371828fda",
      "sampleRate": 22050,
      "durationMs": 2313
    }
  ]
}

{
  "skillId": "MATH.ML.NEURON.WEIGHTED_SUM",
  "locale": "en-IN",
  "licence": "owner-original",
  "approvalStatus": "draft",
  "id": "nn.patch",
  "kind": "passage",
  "text": "A neuron looks at a short strip of pixels. Each pixel is a number for how bright it is, and each pixel has a weight of its own.",
  "expressions": {
    "nn.x1": {
      "op": "num",
      "n": 1
    },
    "nn.x2": {
      "op": "num",
      "n": 0
    },
    "nn.x3": {
      "op": "num",
      "n": 1
    },
    "nn.w1": {
      "op": "num",
      "n": 2
    },
    "nn.w2": {
      "op": "neg",
      "a": {
        "op": "num",
        "n": 1
      }
    },
    "nn.w3": {
      "op": "num",
      "n": 3
    },
    "nn.p1": {
      "op": "mul",
      "a": {
        "op": "num",
        "n": 2
      },
      "b": {
        "op": "num",
        "n": 1
      }
    },
    "nn.p2": {
      "op": "mul",
      "a": {
        "op": "neg",
        "a": {
          "op": "num",
          "n": 1
        }
      },
      "b": {
        "op": "num",
        "n": 0
      }
    },
    "nn.p3": {
      "op": "mul",
      "a": {
        "op": "num",
        "n": 3
      },
      "b": {
        "op": "num",
        "n": 1
      }
    }
  },
  "grids": {
    "pixels": {
      "cols": 3,
      "cells": [
        "nn.x1",
        "nn.x2",
        "nn.x3"
      ],
      "tint": "brightness",
      "label": "Pixels"
    },
    "weights": {
      "cols": 3,
      "cells": [
        "nn.w1",
        "nn.w2",
        "nn.w3"
      ],
      "tint": "signed",
      "label": "Weights"
    },
    "products": {
      "cols": 3,
      "cells": [
        "nn.p1",
        "nn.p2",
        "nn.p3"
      ],
      "tint": "signed",
      "label": "Products"
    }
  },
  "sourceNote": "Written for this project as the patch of pixels, the weights and their products of the neuron lesson (ADR 0076). No outside text.",
  "hash": "a7a0d97591d281d43477cd5982f9ab147ead64f28f291211f530ef127ef32aeb"
}

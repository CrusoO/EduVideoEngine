{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "mutate": [
    "packages/schema/src/validate.ts",
    "packages/content/src/derive.ts",
    "packages/content/src/validate.ts"
  ],
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation-waived.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 0
  },
  "coverageAnalysis": "perTest",
  "concurrency": 6,
  "timeoutMS": 60000,
  "_comment": "REPORT-ONLY. The files waived by ADR 0045 until 2026-10-28. break is 0 so the run never fails; the point is the per-file score and the survivor list. packages/gates/tests/waiver.test.ts fails after the expiry date. Files that reach 90 move to stryker.config.json.",
  "_expires": "2026-10-28"
}

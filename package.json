{
  "name": "edu-video-engine",
  "private": true,
  "version": "0.0.0",
  "description": "Educational video engine: a compiler from a typed LessonBundle to a deterministic, offline, interactive lesson player.",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mutate": "stryker run && vite-node scripts/mutation-floor.ts",
    "voice:generate": "vite-node scripts/voice/generate.ts",
    "reference:build": "vite-node scripts/reference-lesson.ts",
    "harness:hashes": "vite-node scripts/harness-hashes.ts",
    "gen:ops": "vite-node scripts/gen-ops.ts",
    "gen:costs": "vite-node scripts/gen-costs.ts",
    "verify:gate": "vite-node scripts/verify-gate.ts",
    "secrets:check": "vite-node scripts/secrets-check.ts",
    "docs:check": "vite-node scripts/docs-check.ts",
    "prepare": "git config core.hooksPath .githooks",
    "content:seed": "vite-node scripts/content-seed-sum-of-roots.ts",
    "content:validate": "vite-node scripts/content-validate.ts",
    "content:seal": "vite-node scripts/content-seal.ts",
    "llm:usage": "vite-node scripts/llm-usage.ts",
    "plan:lesson": "node --use-system-ca node_modules/vite-node/vite-node.mjs scripts/plan-lesson.ts",
    "lesson:build": "node --use-system-ca node_modules/vite-node/vite-node.mjs scripts/build-lesson.ts",
    "lesson:play": "vite-node scripts/lesson-play.ts",
    "lesson:studio": "node --use-system-ca node_modules/vite-node/vite-node.mjs scripts/lesson-studio.ts",
    "lesson:inspector": "node --use-system-ca node_modules/vite-node/vite-node.mjs scripts/lesson-inspector.ts",
    "patterns:report": "vite-node scripts/pattern-report.ts",
    "lesson:quality": "vite-node scripts/lesson-quality.ts",
    "lesson:lab": "vite-node scripts/lesson-lab.ts",
    "player:size": "vite-node scripts/player-size.ts",
    "llm:smoke": "node --use-system-ca node_modules/vite-node/vite-node.mjs scripts/llm-smoke.ts",
    "llm:probes": "node --use-system-ca node_modules/vite-node/vite-node.mjs scripts/llm-probes.ts",
    "llm:models": "node --use-system-ca node_modules/vite-node/vite-node.mjs scripts/llm-models.ts",
    "llm:sizes": "node --use-system-ca node_modules/vite-node/vite-node.mjs scripts/llm-sizes.ts",
    "mutate:floor": "vite-node scripts/mutation-floor.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/vitest-runner": "8.7.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite-node": "2.1.9",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  }
}

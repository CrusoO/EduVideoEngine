{
  "name": "edu-video-engine",
  "private": true,
  "version": "0.0.0",
  "description": "Educational video engine: a compiler from a typed LessonBundle to a deterministic, offline, interactive lesson player.",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mutate": "stryker run",
    "voice:generate": "vite-node scripts/voice/generate.ts",
    "gen:ops": "vite-node scripts/gen-ops.ts",
    "gen:costs": "vite-node scripts/gen-costs.ts",
    "verify:gate": "vite-node scripts/verify-gate.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/vitest-runner": "8.7.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite-node": "2.1.9",
    "vitest": "^2.1.8"
  }
}

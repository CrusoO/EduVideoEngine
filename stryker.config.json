{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "mutate": [
    "packages/resolver/src/resolve.ts",
    "packages/resolver/src/events.ts",
    "packages/player/src/clock.ts",
    "packages/player/src/player.ts",
    "packages/layout/src/solve.ts",
    "packages/layout/src/check.ts",
    "packages/layout/src/measure.ts",
    "packages/layout/src/budget.ts",
    "packages/schema/src/migrate.ts",
    "packages/schema/src/validate.ts",
    "packages/content/src/derive.ts",
    "packages/content/src/validate.ts",
    "packages/gates/src/g1-coherence.ts",
    "packages/gates/src/g2-delivery.ts",
    "packages/gates/src/g3-active-visual.ts",
    "packages/gates/src/g4-arc.ts",
    "packages/gates/src/g5-role.ts",
    "packages/gates/src/g6-prerequisites.ts",
    "packages/gates/src/g7-coverage.ts",
    "packages/gates/src/approvals.ts",
    "packages/gates/src/helpers.ts",
    "packages/gates/src/harness.ts",
    "packages/patterns/src/arcs.ts",
    "packages/safety/src/secrets-scan.ts",
    "packages/adapters/src/env.ts",
    "packages/adapters/src/limiter.ts"
  ],
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "coverageAnalysis": "perTest",
  "concurrency": 6,
  "timeoutMS": 60000
}

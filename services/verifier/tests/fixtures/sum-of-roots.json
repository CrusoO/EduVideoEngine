  "script": [
    {
      "id": "s1.1",
      "beatId": "b1",
      "text": "Here is a quadratic equation: {expr:eq1}.",
      "termSpans": [
        {
          "glossaryId": "g.quadratic",
          "start": 10,
          "end": 19
        }
      ],
      "exprRefs": [
        "eq1"
      ],
      "status": "frozen"
    },
    {
      "id": "s1.2",
      "beatId": "b1",
      "text": "It has two roots. Before we solve it, guess what they add up to.",
      "termSpans": [
        {
          "glossaryId": "g.root",
          "start": 11,
          "end": 16
        }
      ],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s2.1",
      "beatId": "b2",
      "text": "Let us draw this equation. The curve is called a parabola.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s2.2",
      "beatId": "b2",
      "text": "The roots are the two places where the curve crosses the horizontal axis.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s3.1",
      "beatId": "b3",
      "text": "One root is two.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s3.2",
      "beatId": "b3",
      "text": "The other root is three.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s3.3",
      "beatId": "b3",
      "text": "Now we have found both roots.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s4.1",
      "beatId": "b4",
      "text": "Start at zero. The first root is two, so hop to two.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s4.2",
      "beatId": "b4",
      "text": "The second root is three, so hop three more and land on five.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s4.3",
      "beatId": "b4",
      "text": "The two roots add up to {expr:total}.",
      "termSpans": [],
      "exprRefs": [
        "total"
      ],
      "status": "frozen"
    },
    {
      "id": "s4.4",
      "beatId": "b4",
      "text": "Look at the minus five x term. The sum is five, the same number with its sign flipped.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    }
  ],

  "script": [
    {
      "id": "s1.1",
      "beatId": "b1",
      "text": "Here is a quadratic equation: {expr:eq1}.",
      "termSpans": [
        {
          "glossaryId": "g.quadratic",
          "start": 10,
          "end": 19
        }
      ],
      "exprRefs": [
        "eq1"
      ],
      "status": "frozen"
    },
    {
      "id": "s1.2",
      "beatId": "b1",
      "text": "It has two roots. Before we solve it, guess what they add up to.",
      "termSpans": [
        {
          "glossaryId": "g.root",
          "start": 11,
          "end": 16
        }
      ],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s2.1",
      "beatId": "b2",
      "text": "For any equation of the form {expr:general}, there is a shortcut.",
      "termSpans": [],
      "exprRefs": [
        "general"
      ],
      "status": "frozen"
    },
    {
      "id": "s2.2",
      "beatId": "b2",
      "text": "The sum of the two roots is always {expr:rule}.",
      "termSpans": [],
      "exprRefs": [
        "rule"
      ],
      "status": "frozen"
    },
    {
      "id": "s2.3",
      "beatId": "b2",
      "text": "You only need the first two coefficients. The last one does not matter.",
      "termSpans": [
        {
          "glossaryId": "g.coefficient",
          "start": 41,
          "end": 53
        }
      ],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s3.1",
      "beatId": "b3",
      "text": "Let us check it. Factorise the equation to get {expr:factored}.",
      "termSpans": [],
      "exprRefs": [
        "factored"
      ],
      "status": "frozen"
    },
    {
      "id": "s3.2",
      "beatId": "b3",
      "text": "So the roots are two and three, and {expr:total}.",
      "termSpans": [],
      "exprRefs": [
        "total"
      ],
      "status": "frozen"
    },
    {
      "id": "s3.3",
      "beatId": "b3",
      "text": "The rule gives the same answer: {expr:fromRule}.",
      "termSpans": [],
      "exprRefs": [
        "fromRule"
      ],
      "status": "frozen"
    },
    {
      "id": "s4.1",
      "beatId": "b4",
      "text": "On the graph, the roots are where the curve crosses the horizontal axis.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s4.2",
      "beatId": "b4",
      "text": "The crossings are at two and three, exactly halfway between them sits the lowest point.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    },
    {
      "id": "s5.1",
      "beatId": "b5",
      "text": "Now you try. For {expr:eq2}, what do the roots add up to?",
      "termSpans": [],
      "exprRefs": [
        "eq2"
      ],
      "status": "frozen"
    },
    {
      "id": "s5.2",
      "beatId": "b5",
      "text": "Use the rule, then check your answer.",
      "termSpans": [],
      "exprRefs": [],
      "status": "frozen"
    }
  ],
